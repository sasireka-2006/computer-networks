#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>
#include <sys/types.h>
#include <netinet/in.h>

#define PORT 8080
#define BUFFER_SIZE 1024

void createServer(int *sockfd)
{
    *sockfd = socket(AF_INET, SOCK_STREAM, 0);

    if (*sockfd < 0)
    {
        perror("Socket creation failed");
        exit(1);
    }
}

void bindServer(int sockfd, char *ip)
{
    struct sockaddr_in server;

    server.sin_family = AF_INET;
    server.sin_port = htons(PORT);
    inet_pton(AF_INET, ip, &server.sin_addr);

    if (bind(sockfd, (struct sockaddr *)&server, sizeof(server)) < 0)
    {
        perror("Bind failed");
        exit(1);
    }
}

void handleClient(int clientfd, struct sockaddr_in client)
{
    char buffer[BUFFER_SIZE];
    char clientIP[INET_ADDRSTRLEN];

    inet_ntop(AF_INET, &client.sin_addr, clientIP, sizeof(clientIP));

    printf("Client connected: %s:%d\n",
           clientIP, ntohs(client.sin_port));

    send(clientfd, "Connected to chat server\n", 25, 0);

    while (1)
    {
        memset(buffer, 0, sizeof(buffer));

        int n = recv(clientfd, buffer, sizeof(buffer) - 1, 0);

        if (n <= 0)
            break;

        printf("Client %s: %s", clientIP, buffer);

        if (strncmp(buffer, "exit", 4) == 0)
            break;

        printf("Server: ");
        fgets(buffer, sizeof(buffer), stdin);

        send(clientfd, buffer, strlen(buffer), 0);
    }

    close(clientfd);
    printf("Client disconnected: %s\n", clientIP);
}

void runServer(char *ip)
{
    int sockfd, clientfd;
    struct sockaddr_in client;
    socklen_t length = sizeof(client);

    createServer(&sockfd);
    bindServer(sockfd, ip);

    if (listen(sockfd, 5) < 0)
    {
        perror("Listen failed");
        exit(1);
    }

    printf("Chat server running on %s:%d\n", ip, PORT);

    while (1)
    {
        clientfd = accept(sockfd,
                          (struct sockaddr *)&client,
                          &length);

        if (clientfd < 0)
        {
            perror("Accept failed");
            continue;
        }

        if (fork() == 0)
        {
            close(sockfd);
            handleClient(clientfd, client);
            exit(0);
        }

        close(clientfd);
    }
}

int main(int argc, char *argv[])
{
    if (argc != 2)
    {
        printf("Usage: %s <server_ip>\n", argv[0]);
        return 1;
    }

    runServer(argv[1]);

    return 0;
}
