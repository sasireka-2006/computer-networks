#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define PORT 8081
#define BUFFER_SIZE 1024

struct arpEntry
{
    char ip[20];
    char mac[20];
};

struct arpEntry table[] =
{
    {"192.168.1.1", "AA:BB:CC:DD:EE:01"},
    {"192.168.1.2", "AA:BB:CC:DD:EE:02"},
    {"192.168.1.3", "AA:BB:CC:DD:EE:03"},
    {"192.168.1.4", "AA:BB:CC:DD:EE:04"}
};

void createSocket(int *sockfd)
{
    *sockfd = socket(AF_INET, SOCK_STREAM, 0);

    if (*sockfd < 0)
    {
        perror("Socket creation failed");
        exit(1);
    }
}

void bindServer(int sockfd, char *ip)
{
    struct sockaddr_in server;

    server.sin_family = AF_INET;
    server.sin_port = htons(PORT);

    if (inet_pton(AF_INET, ip, &server.sin_addr) <= 0)
    {
        perror("Invalid IP address");
        exit(1);
    }

    if (bind(sockfd,
             (struct sockaddr *)&server,
             sizeof(server)) < 0)
    {
        perror("Bind failed");
        exit(1);
    }
}

void searchARP(int clientfd)
{
    char ip[BUFFER_SIZE];
    char response[BUFFER_SIZE];

    memset(ip, 0, sizeof(ip));

    recv(clientfd, ip, sizeof(ip) - 1, 0);

    ip[strcspn(ip, "\n")] = '\0';

    printf("Searching ARP table for IP: %s\n", ip);

    for (int i = 0; i < 4; i++)
    {
        if (strcmp(ip, table[i].ip) == 0)
        {
            strcpy(response, table[i].mac);

            printf("MAC found: %s\n", response);

            send(clientfd,
                 response,
                 strlen(response),
                 0);

            return;
        }
    }

    strcpy(response, "MAC address not found");

    printf("%s\n", response);

    send(clientfd,
         response,
         strlen(response),
         0);
}

void handleClient(int clientfd, struct sockaddr_in client)
{
    char clientIP[INET_ADDRSTRLEN];

    inet_ntop(AF_INET,
              &client.sin_addr,
              clientIP,
              sizeof(clientIP));

    printf("\n--------------------------------\n");
    printf("Client connected\n");
    printf("Client IP   : %s\n", clientIP);
    printf("Client Port : %d\n", ntohs(client.sin_port));
    printf("Socket FD   : %d\n", clientfd);
    printf("--------------------------------\n");

    searchARP(clientfd);

    close(clientfd);

    printf("Client %s disconnected\n", clientIP);
}

void runServer(char *ip)
{
    int sockfd;
    int clientfd;

    struct sockaddr_in client;
    socklen_t length;

    createSocket(&sockfd);

    bindServer(sockfd, ip);

    if (listen(sockfd, 5) < 0)
    {
        perror("Listen failed");
        exit(1);
    }

    printf("=================================\n");
    printf("      CONCURRENT ARP SERVER\n");
    printf("=================================\n");
    printf("Server IP   : %s\n", ip);
    printf("Server Port : %d\n", PORT);
    printf("Waiting for clients...\n");

    while (1)
    {
        length = sizeof(client);

        clientfd = accept(sockfd,
                          (struct sockaddr *)&client,
                          &length);

        if (clientfd < 0)
        {
            perror("Accept failed");
            continue;
        }

        /*
           Create a separate child process
           for every client.
        */
        if (fork() == 0)
        {
            close(sockfd);

            handleClient(clientfd, client);

            exit(0);
        }

        /*
           Parent does not handle the client.
           It immediately goes back to accept()
           and waits for another client.
        */
        close(clientfd);
    }
}

int main(int argc, char *argv[])
{
    if (argc != 2)
    {
        printf("Usage: %s <server_ip>\n", argv[0]);
        return 1;
    }

    runServer(argv[1]);

    return 0;
}
