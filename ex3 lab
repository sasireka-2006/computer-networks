#include <stdio.h>

#define ROWS 4
#define COLS 4

int sender[ROWS + 1][COLS + 1];
int receiver[ROWS + 1][COLS + 1];

void getData();
void calculateRowParity();
void calculateColumnParity();
void displaySender();
void receiveData();
void checkParity();
void introduceError();
void displayReceiver();
void checkParity();

void getData()
{
    int i,j;

    printf("Enter %d x %d Binary Data:\n",ROWS,COLS);

    for(i=0;i<ROWS;i++)
    {
        for(j=0;j<COLS;j++)
        {
            scanf("%d",&sender[i][j]);
        }
    }
}

void calculateRowParity()
{
    int i,j,count;

    for(i=0;i<ROWS;i++)
    {
        count=0;

        for(j=0;j<COLS;j++)
        {
            if(sender[i][j]==1)
                count++;
        }

        if(count%2==0)
            sender[i][COLS]=0;
        else
            sender[i][COLS]=1;
    }
}

void calculateColumnParity()
{
    int i,j,count;

    for(j=0;j<COLS;j++)
    {
        count=0;

        for(i=0;i<ROWS;i++)
        {
            if(sender[i][j]==1)
                count++;
        }

        if(count%2==0)
            sender[ROWS][j]=0;
        else
            sender[ROWS][j]=1;
    }

    count=0;

    for(j=0;j<COLS;j++)
    {
        if(sender[ROWS][j]==1)
            count++;
    }

    if(count%2==0)
        sender[ROWS][COLS]=0;
    else
        sender[ROWS][COLS]=1;
}

void displaySender()
{
    int i,j;

    printf("\nSender 2D Parity Matrix:\n\n");

    for(i=0;i<=ROWS;i++)
    {
        for(j=0;j<=COLS;j++)
        {
            printf("%d ",sender[i][j]);
        }
        printf("\n");
    }
}
void receiveData()
{
    int i,j;

    for(i=0;i<=ROWS;i++)
    {
        for(j=0;j<=COLS;j++)
        {
            receiver[i][j]=sender[i][j];
        }
    }
}

void introduceError()
{
    int choice,row,col;

    printf("\nDo you want to introduce an error?\n");
    printf("1. Yes\n");
    printf("2. No\n");
    printf("Enter Choice : ");
    scanf("%d",&choice);

    if(choice==1)
    {
        printf("Enter Row (1-%d): ",ROWS);
        scanf("%d",&row);

        printf("Enter Column (1-%d): ",COLS);
        scanf("%d",&col);

        row--;
        col--;

        if(receiver[row][col]==0)
            receiver[row][col]=1;
        else
            receiver[row][col]=0;
    }
}

void displayReceiver()
{
    int i,j;

    printf("\nReceiver Matrix:\n\n");

    for(i=0;i<=ROWS;i++)
    {
        for(j=0;j<=COLS;j++)
        {
            printf("%d ",receiver[i][j]);
        }
        printf("\n");
    }
}

void checkParity()
{
    int i,j;
    int count;
    int rowError=-1;
    int colError=-1;
    int rowCount=0;
    int colCount=0;

    /* Check Row Parity */

    for(i=0;i<ROWS;i++)
    {
        count=0;

        for(j=0;j<COLS;j++)
        {
            if(receiver[i][j]==1)
                count++;
        }

        if((count%2)!=receiver[i][COLS])
        {
            rowError=i;
            rowCount++;
        }
    }

    /* Check Column Parity */

    for(j=0;j<COLS;j++)
    {
        count=0;

        for(i=0;i<ROWS;i++)
        {
            if(receiver[i][j]==1)
                count++;
        }

        if((count%2)!=receiver[ROWS][j])
        {
            colError=j;
            colCount++;
        }
    }

    if(rowCount==0 && colCount==0)
    {
        printf("\nData received without error.\n");
    }
    else if(rowCount==1 && colCount==1)
    {
        printf("\nSingle Bit Error Detected.\n");

        printf("Error Position : Row %d Column %d\n",
               rowError+1,colError+1);

        receiver[rowError][colError]^=1;

        printf("\nError Corrected Successfully.\n");

        printf("\nCorrected Matrix:\n");

        for(i=0;i<=ROWS;i++)
        {
            for(j=0;j<=COLS;j++)
            {
                printf("%d ",receiver[i][j]);
            }
            printf("\n");
        }
    }
    else
    {
        printf("\nMultiple Errors Detected.\n");
        printf("Error cannot be corrected.\n");
    }
}

int main()
{
    getData();

    calculateRowParity();

    calculateColumnParity();

    displaySender();

    receiveData();

    introduceError();

    displayReceiver();

    checkParity();

    return 0;
}
